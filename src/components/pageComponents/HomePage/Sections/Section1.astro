---
import LogoImg from '../../../../assets/zyn-blured-logo.webp'
---
<!------- Section 1 --------->

<section class="zyntics-section zyntics-container-auto  bg-white text-black px-6">
  <div class="grid grid-cols-1 lg:grid-cols-[0.8fr_1fr] gap px-2 md:px-10">
  
  <!-- Right Side (Comes first on mobile) -->
  <div class="order-1 lg:order-2 flex items-center justify-center text-left lg:text-left">
    <div>
      <h2 class="text-h1 font-extrabold leading-tight text-[#313131]">
        Apps that power enterprise agility
      </h2>
      <p class="text-md lg:text-lg font-medium leading-normal text-[#515151] max-w-2xl pt-4 md:px-3 ">
         We specialize in developing custom applications and web solutions that align perfectly with your unique business goals and user engagement  
      </p>
    </div>
  </div>

  <!-- Left Side (Comes second on mobile) -->
 <div class="order-2 lg:order-1 grid grid-cols-[0.4fr_1fr] sm:grid-cols-2 gap-6 items-center mt-6 md:mt-0">
  
  <!-- Image Block - Comes first on mobile -->
<div class="order-1 lg:order-2">
  <img
    src={LogoImg.src}
    alt="Sample"
    class="w-full max-w-[280px] h-auto mx-auto sm:mx-0 transition-transform duration-500 ease-in-out hover:scale-110 hover:-rotate-2"
  />
</div>


  <!-- Text Block - Comes second on mobile -->
  <div class="order-2 lg:order-1">
    <h3 class="text-small-p uppercase font-bold mb-4 leading-snug tracking-widest">Zyntics Engine</h3>
    <p class="text-gray-700 zyntics-p ">
      Your tech foundation for scalable, long-term digital success.
    </p>
  </div>
</div>


</div>


<img
  src="https://variety.axiomthemes.com/wp-content/uploads/2024/01/image-6-copyright.jpg"
  alt="Background Design"
  class="mt-20 mx-auto w-full max-w-full object-cover h-50 md:h-100"
/>
</section>
