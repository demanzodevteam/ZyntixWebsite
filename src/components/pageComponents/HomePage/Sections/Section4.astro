            <i class="fas fa-check-circle text-[#6c63ff] text-base"></i>
            <span class="font-semibold">UI/UX Builds</span>
          </li>
          <li class="flex items-center gap-2">
            <i class="fas fa-check-circle text-[#6c63ff] text-base"></i>
            <span class="font-semibold">Scale on Demand</span>
