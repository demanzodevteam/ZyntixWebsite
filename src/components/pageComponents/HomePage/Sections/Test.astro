---
import ContactSection from "../../../common/ContactSection";
import MapEmbed from "../../../common/MapEmbed.jsx";
import ContactForm from "../../../common/ContactForm.jsx";
---
<section class="w-full px-4 py-10 bg-white space-y-10">
  <!-- Grid: Both Images -->
 <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-[1fr_2fr] items-start gap-8">
  
  <!-- Left Side - Small Image Only aligned to top -->
  <div class="flex items-start">
    <img 
      src="https://images.unsplash.com/photo-1607746882042-944635dfe10e?auto=format&fit=crop&w=300&q=80" 
      alt="Strategy Planning" 
      class="object-cover rounded-lg shadow-md w-full "
    />
  </div>

  <!-- Right Side - Big Image Only -->
  <div>
    <img 
      src="https://images.unsplash.com/photo-1504384308090-c894fdcc538d?auto=format&fit=crop&w=1920&q=80" 
      alt="Teamwork Collaboration" 
      class="w-full h-auto object-cover rounded-xl shadow-lg"
    />
  </div>
</div>


  <!-- Grid: Text Section (Reusing same 1fr_2fr layout) -->
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-[1fr_2fr] items-start gap-8">
    
    <!-- Left Side - Heading + Paragraph -->
    <div>
      <p class="text-sm uppercase tracking-wide font-bold text-gray-500">Unique Strategies</p>
      <h2 class="text-4xl md:text-4xl font-bold leading-tight mt-4">Business <br> growth</h2>
    </div>

    <!-- Right Side - Two Column HR + Paragraphs -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Column 1 -->
      <div class="px-4">
        <hr class=" mb-6 w-full border-t-3 border-gray-400 rounded-full" />
        <p class="text-gray-700 text-sm">
          Our strategies are tailored to meet unique business needs with a focus on long-term scalability. Lorem ipsum dolor sit amet consectetur adipisicing elit. Sed nulla voluptas doloremque porro possimus excepturi recusandae molestias harum delectus earum?
        </p>
      </div>

      <!-- Column 2 -->
      <div class="px-4">
        <hr class="mb-6 w-full border-t-3 border-gray-400 rounded-full" />
        <p class="text-gray-700 text-sm">
          We ensure performance and responsive interfaces across all digital platforms. Lorem ipsum dolor, sit amet consectetur adipisicing elit. Expedita dolores facilis voluptatibus dolore aut fuga beatae quos, reprehenderit porro autem?
        </p>
      </div>
    </div>
  </div>
</section>


<section class="relative w-full h-[60vh] md:h-[60vh] overflow-hidden">
  <!-- Background Image -->
  <img 
    src="https://images.unsplash.com/photo-1504384308090-c894fdcc538d?auto=format&fit=crop&w=1920&q=80" 
    alt="Nature Advice Background"
    class="w-full h-full object-cover"
  />

  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/40"></div>

  <!-- Centered Text -->
  <div class="absolute inset-0 flex items-center justify-center">
    <h2 class="text-white text-4xl md:text-6xl font-bold">Advice</h2>
  </div>
</section>


<section class="w-full px-4 py-16 bg-[#F6F6F6] text-center ">
  <div class="max-w-7xl mx-auto">
    
    <!-- Top Paragraph -->
    <p class="text-sm uppercase tracking-wide font-bold text-gray-500 mb-2">
      What we do
    </p>

    <!-- Main Heading -->
    <h1 class="mt-4">
      <span class="text-4xl md:text-5xl font-bold leading-tight">Enchancing Strategies,nurturing <br>growth,orchestrating the pathway <br>for your </span>
      <span class="text-4xl md:text-4xl font-semibold leading-tight"> <i> thriving business</i></span> 
    </h1>

    <!-- Subtitle -->
    <h6 class="text-lg font-bold mt-6">
      Peter Bowman
    </h6>
    <p class="text-base text-gray-600 ">
      Creative Director
    </p>

  </div>

   <!-- Cards Section -->
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row flex-wrap gap-8 justify-start mt-[120px]">
    
    <!-- Card 1 -->
    <div class="bg-white p-6 w-full sm:w-72 h-72 flex items-center justify-center">
      <img 
        src="https://source.unsplash.com/200x200/?growth,chart" 
        alt="Growth Chart" 
        class="w-24 h-24 object-cover rounded-full"
      />
    </div>

    <!-- Card 2 -->
    <div class="bg-white p-6 w-full sm:w-72 h-72 flex items-center justify-center ">
      <img 
        src="https://source.unsplash.com/200x200/?teamwork" 
        alt="Teamwork" 
        class="w-24 h-24 object-cover rounded-full"
      />
    </div>
  </div>
</section>


<!-- <ContactSection client:load /> -->
<section class="w-full grid grid-cols-1 md:grid-cols-2 bg-gray-50 ">
  <div class="">
    <MapEmbed client:load />
  </div>
  <div class="flex items-center justify-center px-6 py-12">
    <ContactForm client:load />
  </div>
</section>

<section class="w-full px-4 py-16 bg-white text-black border-t border-gray-400">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 py-14">
    
    <!-- Left Side: Heading -->
    <div class="flex items-start justify-start">
      <h2 class="text-3xl md:text-4xl font-bold text-left">
        We shape strategy & <br />
        sculpt success
      </h2>
    </div>

    <!-- Right Side: Two inner divs -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
      
      <!-- Inner Div 1: Address + Social -->
      <div class="space-y-4">
        <h4 class="text-lg font-bold">Address</h4>
        <p class="text-gray-700">1234 Startup Lane,<br />Innovation City, IN 560001</p>

        <!-- Social Icons -->
        <div class="flex gap-4 mt-6">
          <a href="#" aria-label="Facebook" class="text-gray-600 hover:text-black transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-facebook-icon lucide-facebook"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="#" aria-label="Instagram" class="text-gray-600 hover:text-black transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-instagram-icon lucide-instagram"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
          <a href="#" aria-label="LinkedIn" class="text-gray-600 hover:text-black transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin-icon lucide-linkedin"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>          </a>
          <a href="#" aria-label="X" class="text-gray-600 hover:text-black transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </a>
        </div>
      </div>

      <!-- Inner Div 2: Email + Phone -->
      <div class="space-y-4">
        <h4 class="text-lg font-bold">Say Hello</h4>
        <p class="text-gray-700">Email: contact@startup.com</p>
        <p class="text-gray-700">Phone: +91 98765 43210</p>
      </div>
    </div>

  </div>

</section>
<footer class="w-full px-4 py-6 bg-white text-gray-600">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 items-center border-t border-gray-400 pt-6 pb-5">
    
    <!-- ✅ Left Side: Nav menu aligned to left end -->
    <nav class="flex space-x-6 text-gray-600  text-sm font-medium">
        <a href="#" class="inline-block border-b-2 border-gray-600 pb-1">Home</a>
        <a href="#" class="inline-block hover:border-b-2 hover:border-gray-600 border-transparent pb-1 transition">Blog</a>
        <a href="#" class="inline-block hover:border-b-2 hover:border-gray-600 border-transparent pb-1 transition">Services</a>
        <a href="#" class="inline-block hover:border-b-2 hover:border-gray-600 border-transparent pb-1 transition">Contact</a>
    </nav>

    <!-- ✅ Right Side: All rights reserved -->
    <div class="text-sm text-center md:text-right">
      Zyntics © 2025  All rights reserved.
    </div>

  </div>
</footer>


<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_0.7fr] gap-6 py-6">
    <!-- Left Panel -->
    <div class="bg-[#3ec4d6] rounded-xl flex flex-col justify-between p-6 md:p-10 relative overflow-hidden text-white">
      <div class="absolute top-4 right-4 flex flex-wrap gap-2">
        <span class="bg-white text-black text-xs sm:text-[13px] font-medium py-1 px-3 rounded-full select-none cursor-pointer">AI Solutions</span>
        <span class="bg-white text-black text-xs sm:text-[13px] font-medium py-1 px-3 rounded-full select-none cursor-pointer">AI Services</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold max-w-[14ch] mt-6 leading-12">
        Built for Businesses Ready to Scale, Not Settle
      </h2>
      <div class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-white border-b-2 border-white w-max pb-0.5 hover:text-gray-200 transition-colors">
        <span>Explore more</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          class="lucide lucide-arrow-up-right">
          <path d="M7 7h10v10" />
          <path d="M7 17L17 7" />
        </svg>
      </div>
      <button aria-label="Go next"
        class="absolute bottom-4 right-4 bg-black bg-opacity-80 hover:bg-opacity-95 text-white rounded-full w-10 h-10 flex items-center justify-center transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          class="lucide lucide-arrow-up-right">
          <path d="M7 7h10v10" />
          <path d="M7 17L17 7" />
        </svg>
      </button>
    </div>

    <!-- Middle Panel -->
    <div class="bg-[#8b9ce4] rounded-xl flex flex-col justify-between p-6 md:p-10 relative overflow-hidden text-white min-h-[320px]">
      <div class="absolute top-4 right-4 flex gap-2">
        <button aria-label="Go next"
          class="bg-white bg-opacity-80 hover:bg-opacity-95 text-black rounded-full w-10 h-10 flex items-center justify-center transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            class="lucide lucide-arrow-up-right">
            <path d="M7 7h10v10" />
            <path d="M7 17L17 7" />
          </svg>
        </button>
      </div>
      <h3 class="text-lg sm:text-xl md:text-2xl font-semibold leading-snug max-w-[20ch] mb-2">
        Most off-the-shelf solutions aren’t designed to evolve with your business
      </h3>
      <p class="text-sm md:text-base max-w-[35ch]">
        They limit innovation and create technical debt
      </p>
      <div class="text-5xl sm:text-[60px] font-extrabold leading-none self-start opacity-80 text-outline">
        20k+
      </div>
      <span class="absolute left-4 sm:left-[190px] bottom-[50px] rotate-[-90deg] text-sm font-bold">live users</span>
      <button aria-label="Go next"
        class="absolute bottom-4 right-4 bg-black bg-opacity-80 hover:bg-opacity-95 text-white rounded-full w-10 h-10 flex items-center justify-center transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          class="lucide lucide-arrow-up-right">
          <path d="M7 7h10v10" />
          <path d="M7 17L17 7" />
        </svg>
      </button>
    </div>

    <!-- Right Panel -->
    <div class="bg-[#8a79e0] rounded-xl flex flex-col justify-between p-6 md:p-10 relative overflow-hidden text-white min-h-[320px]">
      <h3 class="text-lg md:text-xl font-semibold leading-snug mb-4">
        At Zyntics, we design and develop systems that grow with you—no template traps, no bloated plugins.
      </h3>
      <p class="text-sm md:text-base max-w-[30ch] mb-10">
        Instant assistance for all your queries. Experience seamless service with our AI-powered support
      </p>
      <div class="flex items-center space-x-2 opacity-50 mb-10">
        <svg class="w-6 h-6 stroke-current" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <path d="M12 22a10 10 0 1 0-10-10 10 10 0 0 0 10 10zm-1-6h2v-6h-2zm0-8h2v2h-2z" />
        </svg>
        <span class="text-sm tracking-wide select-none">24/7</span>
      </div>
      <svg class="absolute top-4 right-4 w-10 h-14 opacity-25 pointer-events-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 28">
        <circle cx="2" cy="2" r="2" fill="white" />
        <circle cx="10" cy="2" r="2" fill="white" />
        <circle cx="18" cy="2" r="2" fill="white" />
        <circle cx="2" cy="10" r="2" fill="white" />
        <circle cx="10" cy="10" r="2" fill="white" />
        <circle cx="18" cy="10" r="2" fill="white" />
        <circle cx="2" cy="18" r="2" fill="white" />
        <circle cx="10" cy="18" r="2" fill="white" />
        <circle cx="18" cy="18" r="2" fill="white" />
        <circle cx="2" cy="26" r="2" fill="white" />
        <circle cx="10" cy="26" r="2" fill="white" />
        <circle cx="18" cy="26" r="2" fill="white" />
      </svg>
    </div>
  </div>

