---
import Slack from '../../../../assets/slack.png'
import Messanger from '../../../../assets/messenger.png'
import Skype from '../../../../assets/skype.png'
import Tel from '../../../../assets/telegram.png'
import Discord from '../../../../assets/discord.png'
import IntegrationSection from '../../../common/IntegrationSection '
---

<!--------- Section 2 ------->

<section class="max-w-[1400px] mx-auto  px-4 sm:px-6 lg:px-0">
  
   <div class="grid grid-cols-1 sm:grid-cols-3 md:grid-cols-[1fr_1fr_0.7fr] gap-4 mb-4 ">
   <!-- Card 1 -->
<div class="relative min-h-[320px] rounded-2xl overflow-hidden z-0">
  <!-- Curved background container -->
  <div class="absolute inset-0 z-0 inverted-radius bg-gradient-to-r from-cyan-400 to-teal-400">
    <img
      src="https://storage.googleapis.com/a1aa/image/3f5045eb-ff59-4c6e-b8f5-e1355e12b194.jpg"
      alt="Robot"
      class="absolute bottom-0 right-0 w-[250px] max-w-[35%] object-contain pointer-events-none" />
  </div>

  <!-- Content -->
  <div class="relative z-10 p-6 text-white flex flex-col h-full justify-between">
    <div class="flex justify-end space-x-2">
      <span class="bg-white text-xs text-gray-700 font-semibold px-3 py-1 rounded-full">AI Solutions</span>
      <span class="bg-white text-xs text-gray-700 font-semibold px-3 py-1 rounded-full">AI Services</span>
    </div>

    <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold max-w-[14ch] leading-12">
      Built for Businesses Ready to Scale, Not Settle
    </h2>

    <a href="#" class="mt-4 text-md flex items-center gap-1 font-light border-b border-white w-max">
      <span>Explore more</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
           class="lucide lucide-arrow-up-right">
        <path d="M7 7h10v10" />
        <path d="M7 17L17 7" />
      </svg>
    </a>
  </div>

  <!-- Animated Button -->
  <button
    aria-label="Open link"
    class="group absolute bottom-1 right-4 z-20 w-11 h-11 rounded-2xl bg-black bg-opacity-80 hover:bg-opacity-95 text-white flex items-center justify-center overflow-hidden transition cursor-pointer">
    
    <!-- Default SVG (slides out on hover) -->
    <svg xmlns="http://www.w3.org/2000/svg"
         class="absolute w-5 h-5 transition-all duration-500 ease-in-out group-hover:translate-x-4 group-hover:-translate-y-4 group-hover:opacity-0"
         viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 7h10v10" />
      <path d="M7 17L17 7" />
    </svg>

    <!-- Hover SVG (slides in from bottom-left) -->
    <svg xmlns="http://www.w3.org/2000/svg"
         class="absolute w-5 h-5 translate-x-[-200%] translate-y-[200%] opacity-0 transition-all duration-300 ease-in-out group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100"
         viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 7h10v10" />
      <path d="M7 17L17 7" />
    </svg>
  </button>
</div>



  <!-- Card 2 -->
<div class="relative min-h-[320px] rounded-2xl overflow-hidden">
  <!-- Masked Background -->
  <div class="absolute inset-0 z-0 inverted-radius bg-gradient-to-tr from-blue-400 to-indigo-400">
    <!-- Background Image -->
    <img src="https://storage.googleapis.com/a1aa/image/e9653d8a-c3e8-48ca-d5f2-ebdf744f4540.jpg"
         alt="Chat App UI"
         class="absolute bottom-0 right-0 w-[280px] max-w-[30%] object-contain pointer-events-none rounded-lg z-0" />
  </div>

  <!-- Content Layer -->
  <div class="relative z-10 p-6 text-white flex flex-col justify-between h-full">
    <!-- Top Button -->
    <div class="flex justify-end">
      <button aria-label="Go next"
              class="bg-white bg-opacity-80 hover:bg-opacity-95 text-black rounded-full w-10 h-10 flex items-center justify-center transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             class="lucide lucide-arrow-up-right">
          <path d="M7 7h10v10" />
          <path d="M7 17L17 7" />
        </svg>
      </button>
    </div>

    <!-- Main Content -->
    <div>
      <h3 class="text-lg md:text-2xl font-semibold max-w-[70%] leading-snug mb-4">
        Most off-the-shelf solutions aren’t designed to evolve with your business
      </h3>
      <p class="text-xs md:text-lg max-w-[70%] font-light leading-relaxed mb-6">
        They limit innovation and create technical debt
      </p>
    </div>

    <!-- Stat Badge -->
    <div class="flex items-center gap-2 max-w-[70%]">
      <span class="text-5xl font-extrabold leading-none tracking-wide select-none text-outline font-sans">20k+</span>
      <span class="text-xs font-light uppercase tracking-widest select-none"
            style="writing-mode: vertical-rl; text-orientation: mixed">
        live users
      </span>
    </div>
  </div>

  <!-- Bottom CTA Button with animation -->
  <button
    aria-label="Open link"
    class="group absolute bottom-1 right-4 z-20 bg-black bg-opacity-80 hover:bg-opacity-95 text-white rounded-2xl w-11 h-11 flex items-center justify-center transition cursor-pointer overflow-hidden">
    
    <!-- Default Icon -->
    <svg xmlns="http://www.w3.org/2000/svg"
         class="absolute w-5 h-5 transition-all duration-500 ease-in-out group-hover:translate-x-4 group-hover:-translate-y-4 group-hover:opacity-0"
         viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 7h10v10" />
      <path d="M7 17L17 7" />
    </svg>

    <!-- Hover Icon -->
    <svg xmlns="http://www.w3.org/2000/svg"
         class="absolute w-5 h-5 translate-x-[-200%] translate-y-[200%] opacity-0 transition-all duration-300 ease-in-out group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100"
         viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 7h10v10" />
      <path d="M7 17L17 7" />
    </svg>
  </button>
</div>


 

<!-- Card 3 -->
<div class="relative rounded-2xl overflow-hidden bg-gradient-to-tr from-purple-400 to-purple-300 p-6 text-white min-h-[320px]">
  <!-- Background Image -->
  <img src="https://storage.googleapis.com/a1aa/image/60bcea35-ba75-44e0-bd5a-42c889c36558.jpg"
       alt="Support Robot"
       class="absolute bottom-0 right-0 w-[250px] max-w-[40%] object-contain z-0 pointer-events-none rounded-lg" />

  <!-- Content -->
  <div class="relative z-10 flex flex-col h-full justify-between">
    <div>
      <h3 class="text-lg md:text-xl font-semibold max-w-[90%] leading-snug mb-4">
        At Zyntics, we design and develop systems that grow with you—no template traps, no bloated plugins.
      </h3>
      <p class="text-sm md:text-base max-w-[90%] font-light leading-relaxed mb-6">
        Instant assistance for all your queries. Experience seamless service with our AI-powered support.
      </p>
    </div>

    <div class="flex items-center gap-2 max-w-[70%]">
      <svg class="w-5 h-5 stroke-current" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
           viewBox="0 0 24 24">
        <path d="M12 22a10 10 0 1 0-10-10 10 10 0 0 0 10 10zm-1-6h2v-6h-2zm0-8h2v2h-2z" />
      </svg>
      <span class="text-xs font-light">24/7</span>
    </div>
  </div>

 
</div>

  </div>
  <IntegrationSection />
  
</section>



