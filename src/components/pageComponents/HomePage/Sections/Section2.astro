---
import Slack from '../../../../assets/slack.png'
import Messanger from '../../../../assets/messenger.png'
import Skype from '../../../../assets/skype.png'
import Tel from '../../../../assets/telegram.png'
import Discord from '../../../../assets/discord.png'

---

<!--------- Section 2 ------->

<style>
  .inverted-radius {
  --r: 20px; /* corner radius */
  --s: 30px; /* size of the inverted curve */
  --x: 20px; /* x offset */
  --y: 10px; /* y offset */

  --_m:/calc(2*var(--r)) calc(2*var(--r)) radial-gradient(#000 70%,#0000 72%);
  --_g:conic-gradient(from 90deg at calc(100% - var(--r)) calc(100% - var(--r)),#0000 25%,#000 0);
  --_d:(var(--s) + var(--r));

  mask:
    calc(100% - var(--_d) - var(--x)) 100% var(--_m),
    100% calc(100% - var(--_d) - var(--y)) var(--_m),
    radial-gradient(var(--s) at 100% 100%,#0000 99%,#000 calc(100% + 1px)) 
      calc(-1*var(--r) - var(--x)) calc(-1*var(--r) - var(--y)),
    var(--_g) calc(-1*var(--_d) - var(--x)) 0,
    var(--_g) 0 calc(-1*var(--_d) - var(--y));
  mask-repeat: no-repeat;
}

</style>


<section class="max-w-[1400px] mx-auto font-sans px-4 sm:px-6 lg:px-0">
  
   <div class="grid grid-cols-1 sm:grid-cols-3 md:grid-cols-[1fr_1fr_0.7fr] gap-4 mb-4 ">
   <!-- Card 1 -->
<div class="relative rounded-2xl overflow-hidden bg-gradient-to-r from-cyan-400 to-teal-400 p-6 text-white min-h-[320px] z-0 inverted-radius">
  <!-- Background Image -->
  <img src="https://storage.googleapis.com/a1aa/image/3f5045eb-ff59-4c6e-b8f5-e1355e12b194.jpg"
       alt="Robot"
       class="absolute bottom-0 right-0 w-[250px] max-w-[35%] object-contain z-0 pointer-events-none rounded-lg inverted-radius" />

  <!-- Content -->
  <div class="relative z-10 flex flex-col h-full justify-between">
    <div class="flex justify-end space-x-2">
      <span class="bg-white text-xs text-gray-700 font-semibold px-3 py-1 rounded-full">AI Solutions</span>
      <span class="bg-white text-xs text-gray-700 font-semibold px-3 py-1 rounded-full">AI Services</span>
    </div>

    <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold max-w-[11ch] leading-12">
      Built for Businesses Ready to Scale, Not Settle
    </h2>

    <a href="#" class="mt-4 text-md flex items-center gap-1 font-light border-b border-white w-max">
      <span>Explore more</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
           class="lucide lucide-arrow-up-right">
        <path d="M7 7h10v10" />
        <path d="M7 17L17 7" />
      </svg>
    </a>
  </div>

  <!-- Action Button -->
  <button aria-label="Go next"
          class="absolute bottom-4 right-4 z-20 bg-black bg-opacity-80 hover:bg-opacity-95 text-white rounded-full w-10 h-10 flex items-center justify-center transition">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
         class="lucide lucide-arrow-up-right">
      <path d="M7 7h10v10" />
      <path d="M7 17L17 7" />
    </svg>
  </button>
</div>

 <!-- Card 2 -->
<div class="relative rounded-2xl overflow-hidden bg-gradient-to-tr from-blue-400 to-indigo-400 p-6 text-white min-h-[320px]">
  <!-- Background Images -->
  <img src="https://storage.googleapis.com/a1aa/image/e9653d8a-c3e8-48ca-d5f2-ebdf744f4540.jpg"
       alt="Chat App UI"
       class="absolute bottom-0 right-0 w-[280px] max-w-[30%] object-contain  z-0 pointer-events-none rounded-lg" />
  <img src="https://storage.googleapis.com/a1aa/image/7a78f7f5-6d4c-426e-36e9-b25ed2eff004.jpg"
       alt="Abstract background"
       class="absolute inset-0 w-full h-full object-cover -z-10 pointer-events-none" />

  <!-- Content -->
  <div class="relative z-10 flex flex-col h-full justify-between">
    <div class="flex justify-end">
        <button aria-label="Go next"
          class="bg-white bg-opacity-80 hover:bg-opacity-95 text-black rounded-full w-10 h-10 flex items-center justify-center transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            class="lucide lucide-arrow-up-right">
            <path d="M7 7h10v10" />
            <path d="M7 17L17 7" />
          </svg>
        </button>
    </div>
    <div>
      <h3 class="text-lg md:text-2xl font-semibold max-w-[70%] leading-snug  mb-4">
       Most off-the-shelf solutions aren’t designed to evolve with your business
      </h3>
      <p class="text-xs md:text-lg max-w-[70%] font-light leading-relaxed mb-6">
        They limit innovation and create technical debt
      </p>
    </div>

    <div class="flex items-center gap-2 max-w-[70%]">
      <span class="text-5xl font-extrabold leading-none tracking-wide select-none text-outline font-sans">20k+</span>
      <span class="text-xs font-light uppercase tracking-widest select-none"
            style="writing-mode: vertical-rl; text-orientation: mixed">live users</span>
    </div>
  </div>

  <!-- CTA Button -->
  <button aria-label="Open link"
          class="absolute bottom-4 right-4 bg-black bg-opacity-80 hover:bg-opacity-95 text-white rounded-full w-10 h-10 flex items-center justify-center transition">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
         class="lucide lucide-arrow-up-right">
      <path d="M7 7h10v10" />
      <path d="M7 17L17 7" />
    </svg>
  </button>
</div>

<!-- Card 3 -->
<div class="relative rounded-2xl overflow-hidden bg-gradient-to-tr from-purple-400 to-purple-300 p-6 text-white min-h-[320px]">
  <!-- Background Image -->
  <img src="https://storage.googleapis.com/a1aa/image/60bcea35-ba75-44e0-bd5a-42c889c36558.jpg"
       alt="Support Robot"
       class="absolute bottom-0 right-0 w-[250px] max-w-[40%] object-contain z-0 pointer-events-none rounded-lg" />

  <!-- Content -->
  <div class="relative z-10 flex flex-col h-full justify-between">
    <div>
      <h3 class="text-lg md:text-xl font-semibold max-w-[90%] leading-snug mb-4">
        At Zyntics, we design and develop systems that grow with you—no template traps, no bloated plugins.
      </h3>
      <p class="text-sm md:text-base max-w-[90%] font-light leading-relaxed mb-6">
        Instant assistance for all your queries. Experience seamless service with our AI-powered support.
      </p>
    </div>

    <div class="flex items-center gap-2 max-w-[70%]">
      <svg class="w-5 h-5 stroke-current" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
           viewBox="0 0 24 24">
        <path d="M12 22a10 10 0 1 0-10-10 10 10 0 0 0 10 10zm-1-6h2v-6h-2zm0-8h2v2h-2z" />
      </svg>
      <span class="text-xs font-light">24/7</span>
    </div>
  </div>

 
</div>

  </div>
  <div class="relative grid grid-cols-1 md:grid-cols-2 gap-10 items-start bg-[#1F1F1F] text-white px-6 sm:px-10 py-8 rounded-xl mb-8">
    <div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-normal leading-tight">
        We work and integrate<br class="hidden sm:block" />with this services
      </h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6 justify-items-center text-center">
      <div><img src={Slack.src} alt="App 1" class="mx-auto w-10 h-10 object-cover" /><h4 class="text-sm mt-2 font-medium">Stack</h4></div>
      <div><img src={Messanger.src} alt="App 2" class="mx-auto w-10 h-10 object-cover" /><h4 class="text-sm mt-2 font-medium">Messanger</h4></div>
      <div><img src={Skype.src} alt="App 3" class="mx-auto w-10 h-10 object-cover" /><h4 class="text-sm mt-2 font-medium">Skype</h4></div>
      <div><img src={Tel.src} alt="App 4" class="mx-auto w-10 h-10 object-cover" /><h4 class="text-sm mt-2 font-medium">Telegram</h4></div>
      <div><img src={Discord.src} alt="App 5" class="mx-auto w-10 h-10 object-cover" /><h4 class="text-sm mt-2 font-medium">Discord</h4></div>
    </div>

    <div class="absolute -bottom-2 -right-2 bg-[#45D0BD] text-black p-2 rounded-md shadow-md">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-up"><path d="m18 15-6-6-6 6"/></svg>
    </div>
  </div>
</section>



