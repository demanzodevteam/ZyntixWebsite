---
import ContactSection from "../../../common/ContactSection";
import MapEmbed from "../../../common/MapEmbed.jsx";
import ContactForm from "../../../common/ContactForm.jsx";
---

<!-- <ContactSection client:load /> -->
<section class="w-full grid grid-cols-1 md:grid-cols-2 bg-gray-50 ">
  <div class="">
    <MapEmbed client:load />
  </div>
  <div class="flex items-center justify-center px-6 py-12">
    <ContactForm client:load />
  </div>
</section>

<section class="w-full px-4 py-16 bg-white text-black border-t border-gray-400">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 py-14">
    
    <!-- Left Side: Heading -->
    <div class="flex items-start justify-start">
      <h2 class="text-3xl md:text-4xl font-bold text-left">
        We shape strategy & <br />
        sculpt success
      </h2>
    </div>

    <!-- Right Side: Two inner divs -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
      
      <!-- Inner Div 1: Address + Social -->
      <div class="space-y-4">
        <h4 class="text-lg font-bold">Address</h4>
        <p class="text-gray-700">1234 Startup Lane,<br />Innovation City, IN 560001</p>

        <!-- Social Icons -->
        <div class="flex gap-4 mt-6">
          <a href="#" aria-label="Facebook" class="text-gray-600 hover:text-black transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-facebook-icon lucide-facebook"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="#" aria-label="Instagram" class="text-gray-600 hover:text-black transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-instagram-icon lucide-instagram"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
          <a href="#" aria-label="LinkedIn" class="text-gray-600 hover:text-black transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin-icon lucide-linkedin"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>          </a>
          <a href="#" aria-label="X" class="text-gray-600 hover:text-black transition">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-icon lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </a>
        </div>
      </div>

      <!-- Inner Div 2: Email + Phone -->
      <div class="space-y-4">
        <h4 class="text-lg font-bold">Say Hello</h4>
        <p class="text-gray-700">Email: contact@startup.com</p>
        <p class="text-gray-700">Phone: +91 98765 43210</p>
      </div>
    </div>

  </div>

</section>
<footer class="w-full px-4 py-6 bg-white text-gray-600">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 items-center border-t border-gray-400 pt-6 pb-5">
    
    <!-- ✅ Left Side: Nav menu aligned to left end -->
    <nav class="flex space-x-6 text-gray-600  text-sm font-medium">
        <a href="#" class="inline-block border-b-2 border-gray-600 pb-1">Home</a>
        <a href="#" class="inline-block hover:border-b-2 hover:border-gray-600 border-transparent pb-1 transition">Blog</a>
        <a href="#" class="inline-block hover:border-b-2 hover:border-gray-600 border-transparent pb-1 transition">Services</a>
        <a href="#" class="inline-block hover:border-b-2 hover:border-gray-600 border-transparent pb-1 transition">Contact</a>
    </nav>

    <!-- ✅ Right Side: All rights reserved -->
    <div class="text-sm text-center md:text-right">
      Zyntics © 2025  All rights reserved.
    </div>

  </div>
</footer>



<section class="relative w-full min-h-screen px-4 py-20 overflow-hidden">
  <!-- 🔮 Glowing Blob Backgrounds -->
  <div class="absolute -top-20 -left-32 w-[500px] h-[500px] bg-[#c5b3f0] rounded-full blur-[160px] opacity-40 z-0"></div>
  <div class="absolute top-10 right-0 w-[600px] h-[600px] bg-[#a8d0f0] rounded-full blur-[200px] opacity-40 z-0"></div>
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-[#e2d4ff] rounded-full blur-[180px] opacity-50 z-0"></div>

  <!-- 📦 Actual Content on top -->
  <div class="relative z-10 max-w-7xl mx-auto flex flex-col lg:flex-row items-center justify-between gap-10">
    <!-- Mission Card -->
    <div class="bg-[#0b1e3d] text-white p-8 rounded-2xl shadow-xl max-w-md w-full">
      <h2 class="text-2xl font-semibold mb-4">Mission</h2>
      <p class="text-sm leading-relaxed text-white/90">
        Our mission is to empower businesses and organizations through innovative development solutions.
        We are committed to delivering exceptional, tailored software, websites, and applications.
      </p>
    </div>

    <!-- Glassy AI Card -->
    <div class="relative w-full max-w-2xl h-[300px] rounded-2xl overflow-hidden shadow-2xl bg-gradient-to-r from-[#a8d0f0] via-[#c5b3f0] to-[#d2e0fc]">
      <img
        src="https://images.unsplash.com/photo-1633613286994-7b2fbb3a2dc2"
        alt="AI Background"
        class="absolute inset-0 w-full h-full object-cover opacity-90"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#1f293700] via-[#00000033] to-[#00000066]"></div>
      <div class="relative z-10 h-full flex flex-col justify-between p-6 text-white">
        <div class="text-lg font-semibold">
          we create a professional product <br />
          using <span class="text-white/90">artificial intelligence</span>
        </div>
        <div class="flex justify-between items-end">
          <div class="text-4xl font-bold">500+</div>
          <div class="text-sm text-white/80">Created projects</div>
        </div>
      </div>
    </div>
  </div>
</section>


<style>
  .glow-background {
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: 100vh;
    background-color: #fff;
    padding: 80px 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Left-side glow - Blue */
  .glow-background::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -200px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #CFECF6, transparent 70%);
    border-radius: 50%;
    transform: translateY(-50%);
    filter: blur(180px);
    opacity: 0.7;
    z-index: 0;
  }

  /* Right-side glow - Purple */
  .glow-background::after {
    content: "";
    position: absolute;
    top: 50%;
    right: -200px;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #CEBEFE, transparent 70%);
    border-radius: 50%;
    transform: translateY(-50%);
    filter: blur(180px);
    opacity: 0.7;
    z-index: 0;
  }

  .glow-content {
    position: relative;
    z-index: 1;
    text-align: center;
    color: #000;
    max-width: 800px;
  }
</style>

<section class="glow-background">
  <div class="glow-content">
    <h2>We Shape Strategy & Sculpt Success</h2>
    <p>
      Empowering businesses with cutting-edge digital solutions and strategic innovation.
    </p>
  </div>
</section>


