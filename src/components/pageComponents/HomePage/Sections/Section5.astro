---
import ImageSlider from "../../../common/ImageSlider";

---

<section class="w-full px-4 py-16 bg-[#F6F6F6] text-center ">
  <div class="max-w-7xl mx-auto">
    
    <!-- Top Paragraph -->
    <p class="text-sm uppercase tracking-wide font-bold text-gray-500 mb-2">
      What we do
    </p>

    <!-- Main Heading -->
    <h1 class="mt-4">
      <span class="text-4xl md:text-5xl font-bold leading-tight">Enchancing Strategies,nurturing <br>growth,orchestrating the pathway <br>for your </span>
      <span class="text-4xl md:text-4xl font-semibold leading-tight"> <i> thriving business</i></span> 
    </h1>

    <!-- Subtitle -->
    <h6 class="text-lg font-bold mt-6">
      Peter Bowman
    </h6>
    <p class="text-base text-gray-600 ">
      Creative Director
    </p>

  </div>

   <!-- Cards Section -->
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row flex-wrap gap-8 justify-start mt-[120px]">
    
    <!-- Card 1 -->
    <div class="bg-white p-6 w-full sm:w-72 h-72 flex items-center justify-center">
      <img 
        src="https://source.unsplash.com/200x200/?growth,chart" 
        alt="Growth Chart" 
        class="w-24 h-24 object-cover rounded-full"
      />
    </div>

    <!-- Card 2 -->
    <div class="bg-white p-6 w-full sm:w-72 h-72 flex items-center justify-center ">
      <img 
        src="https://source.unsplash.com/200x200/?teamwork" 
        alt="Teamwork" 
        class="w-24 h-24 object-cover rounded-full"
      />
    </div>
  </div>
  <ImageSlider />
</section>
