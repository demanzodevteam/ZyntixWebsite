</section>
<footer class="w-full px-4 py-6 bg-white text-gray-600">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 items-center border-t border-gray-400 pt-6 pb-5">
    
    <!-- ✅ Left Side: Nav menu aligned to left end -->
    <nav class="flex space-x-6 text-gray-600  text-sm font-medium">
        <a href="#" class="inline-block border-b-2 border-gray-600 pb-1">Home</a>
        <a href="#" class="inline-block hover:border-b-2 hover:border-gray-600 border-transparent pb-1 transition">Blog</a>
        <a href="#" class="inline-block hover:border-b-2 hover:border-gray-600 border-transparent pb-1 transition">Services</a>
        <a href="#" class="inline-block hover:border-b-2 hover:border-gray-600 border-transparent pb-1 transition">Contact</a>
    </nav>

    <!-- ✅ Right Side: All rights reserved -->
    <div class="text-sm text-center md:text-right">
      Zyntics © 2025  All rights reserved.
    </div>

  </div>
</footer>


<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_0.7fr] gap-6 py-6">
    <!-- Left Panel -->
    <div class="bg-[#3ec4d6] rounded-xl flex flex-col justify-between p-6 md:p-10 relative overflow-hidden text-white">
      <div class="absolute top-4 right-4 flex flex-wrap gap-2">
        <span class="bg-white text-black text-xs sm:text-[13px] font-medium py-1 px-3 rounded-full select-none cursor-pointer">AI Solutions</span>
        <span class="bg-white text-black text-xs sm:text-[13px] font-medium py-1 px-3 rounded-full select-none cursor-pointer">AI Services</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-semibold max-w-[14ch] mt-6 leading-12">
        Built for Businesses Ready to Scale, Not Settle
      </h2>
      <div class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-white border-b-2 border-white w-max pb-0.5 hover:text-gray-200 transition-colors">
        <span>Explore more</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          class="lucide lucide-arrow-up-right">
          <path d="M7 7h10v10" />
          <path d="M7 17L17 7" />
        </svg>
      </div>
      <button aria-label="Go next"
        class="absolute bottom-4 right-4 bg-black bg-opacity-80 hover:bg-opacity-95 text-white rounded-full w-10 h-10 flex items-center justify-center transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          class="lucide lucide-arrow-up-right">
          <path d="M7 7h10v10" />
          <path d="M7 17L17 7" />
        </svg>
      </button>
    </div>

    <!-- Middle Panel -->
    <div class="bg-[#8b9ce4] rounded-xl flex flex-col justify-between p-6 md:p-10 relative overflow-hidden text-white min-h-[320px]">
      <div class="absolute top-4 right-4 flex gap-2">
        <button aria-label="Go next"
          class="bg-white bg-opacity-80 hover:bg-opacity-95 text-black rounded-full w-10 h-10 flex items-center justify-center transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            class="lucide lucide-arrow-up-right">
            <path d="M7 7h10v10" />
            <path d="M7 17L17 7" />
          </svg>
        </button>
      </div>
      <h3 class="text-lg sm:text-xl md:text-2xl font-semibold leading-snug max-w-[20ch] mb-2">
        Most off-the-shelf solutions aren’t designed to evolve with your business
      </h3>
      <p class="text-sm md:text-base max-w-[35ch]">
        They limit innovation and create technical debt
      </p>
      <div class="text-5xl sm:text-[60px] font-extrabold leading-none self-start opacity-80 text-outline">
        20k+
      </div>
      <span class="absolute left-4 sm:left-[190px] bottom-[50px] rotate-[-90deg] text-sm font-bold">live users</span>
      <button aria-label="Go next"
        class="absolute bottom-4 right-4 bg-black bg-opacity-80 hover:bg-opacity-95 text-white rounded-full w-10 h-10 flex items-center justify-center transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          class="lucide lucide-arrow-up-right">
          <path d="M7 7h10v10" />
          <path d="M7 17L17 7" />
        </svg>
      </button>
    </div>

    <!-- Right Panel -->
    <div class="bg-[#8a79e0] rounded-xl flex flex-col justify-between p-6 md:p-10 relative overflow-hidden text-white min-h-[320px]">
      <h3 class="text-lg md:text-xl font-semibold leading-snug mb-4">
        At Zyntics, we design and develop systems that grow with you—no template traps, no bloated plugins.
      </h3>
      <p class="text-sm md:text-base max-w-[30ch] mb-10">
        Instant assistance for all your queries. Experience seamless service with our AI-powered support
      </p>
      <div class="flex items-center space-x-2 opacity-50 mb-10">
        <svg class="w-6 h-6 stroke-current" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <path d="M12 22a10 10 0 1 0-10-10 10 10 0 0 0 10 10zm-1-6h2v-6h-2zm0-8h2v2h-2z" />
        </svg>
        <span class="text-sm tracking-wide select-none">24/7</span>
      </div>
      <svg class="absolute top-4 right-4 w-10 h-14 opacity-25 pointer-events-none" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 28">
        <circle cx="2" cy="2" r="2" fill="white" />
        <circle cx="10" cy="2" r="2" fill="white" />
        <circle cx="18" cy="2" r="2" fill="white" />
        <circle cx="2" cy="10" r="2" fill="white" />
        <circle cx="10" cy="10" r="2" fill="white" />
        <circle cx="18" cy="10" r="2" fill="white" />
        <circle cx="2" cy="18" r="2" fill="white" />
        <circle cx="10" cy="18" r="2" fill="white" />
        <circle cx="18" cy="18" r="2" fill="white" />
        <circle cx="2" cy="26" r="2" fill="white" />
        <circle cx="10" cy="26" r="2" fill="white" />
        <circle cx="18" cy="26" r="2" fill="white" />
      </svg>
    </div>
  </div>
<div>
  <html lang="en">
 <head>
