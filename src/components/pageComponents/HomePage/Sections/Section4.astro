          <li class="flex items-center gap-2">
            <i class="fas fa-check-circle text-[#6c63ff] text-base"></i>
            <span class="font-semibold">Custom Integrations</span>
          </li>
          <li class="flex items-center gap-2">
            <i class="fas fa-check-circle text-[#6c63ff] text-base"></i>
            <span class="font-semibold">Internal Apps</span>
          </li>
          <li class="flex items-center gap-2">
            <i class="fas fa-check-circle text-[#6c63ff] text-base"></i>
