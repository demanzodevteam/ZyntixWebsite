<!-- Script -->
<script>
  const openBtn = document.getElementById("mobile-menu-toggle");
  const closeBtn = document.getElementById("mobile-menu-close");
  const menu = document.getElementById("mobile-menu");

  const tabletOpenBtn = document.getElementById("tablet-menu-toggle");
  const tabletCloseBtn = document.getElementById("tablet-menu-close");
  const tabletMenu = document.getElementById("tablet-menu");

  const disableScroll = () => (document.body.style.overflow = "hidden");
  const enableScroll = () => (document.body.style.overflow = "");

  function openMenu() {
    if (!menu) return;
    menu.classList.remove("pointer-events-none", "opacity-0", "-translate-y-6");
    menu.classList.add("pointer-events-auto", "opacity-100", "translate-y-0");
    disableScroll();
  }

  function closeMenu() {
    if (!menu || !closeBtn) return;
    closeBtn.classList.add("rotate-[360deg]");
    setTimeout(() => {
      menu.classList.add("pointer-events-none", "opacity-0", "-translate-y-6");
      menu.classList.remove(
        "pointer-events-auto",
        "opacity-100",
        "translate-y-0"
      );
      closeBtn.classList.remove("rotate-[360deg]");
      enableScroll();
    }, 500);
  }

  function openTabletMenu() {
    if (!tabletMenu) return;
    tabletMenu.classList.remove(
      "pointer-events-none",
      "opacity-0",
      "-translate-y-6"
    );
    tabletMenu.classList.add(
      "pointer-events-auto",
      "opacity-100",
      "translate-y-0"
    );
    disableScroll();
  }

  function closeTabletMenu() {
    if (!tabletMenu || !tabletCloseBtn) return;
    tabletCloseBtn.classList.add("rotate-[360deg]");
    setTimeout(() => {
      tabletMenu.classList.add(
        "pointer-events-none",
        "opacity-0",
        "-translate-y-6"
      );
      tabletMenu.classList.remove(
        "pointer-events-auto",
        "opacity-100",
        "translate-y-0"
      );
      tabletCloseBtn.classList.remove("rotate-[360deg]");
      enableScroll();
    }, 500);
  }

  openBtn?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  tabletOpenBtn?.addEventListener("click", openTabletMenu);
  tabletCloseBtn?.addEventListener("click", closeTabletMenu);

  // Sticky on scroll (disabled if menu is open)
  window.addEventListener("scroll", function () {
    const navbar = document.getElementById("main-navbar");
    const menuOpen =
      menu?.classList.contains("pointer-events-auto") ||
      tabletMenu?.classList.contains("pointer-events-auto");
    if (!navbar || menuOpen) return;

    if (window.scrollY > 900) {
      navbar.classList.add("md:sticky", "md:top-0", "shadow-md");
    } else {
      navbar.classList.remove("md:sticky", "md:top-0", "shadow-md");
    }
  });
</script>
