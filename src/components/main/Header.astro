---
import Logo from '../../assets/Asset 1.png'
---

<nav id="main-navbar" class="w-full bg-white z-50 transition-all duration-300 ease-in-out transform">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 lg:py-4">
    <div class="flex items-center justify-between h-16">

      <!-- Left: Logo -->
      <div class="flex-shrink-0">
        <a href="#" class="text-xl font-bold">
          <img src={Logo.src} alt="Logo" class="w-[170px] md:w-[190px] lg:w-[200px]" />
        </a>
      </div>

      <!-- Center: Nav Links -->
      <div class="hidden md:flex space-x-6">
        <a href="#" class="font-medium hover:underline hover:underline-offset-4 hover:decoration-black">Home</a>
        <a href="#" class="font-medium hover:underline hover:underline-offset-4 hover:decoration-black">Pages</a>
        <a href="#" class="font-medium hover:underline hover:underline-offset-4 hover:decoration-black">Portfolio</a>
        <a href="#" class="font-medium hover:underline hover:underline-offset-4 hover:decoration-black">Blog</a>
        <a href="#" class="font-medium hover:underline hover:underline-offset-4 hover:decoration-black">Shop</a>
      </div>

      <!-- Right: Desktop Icons -->
      <div class="hidden md:flex items-center space-x-4">
        <button class="hover:text-blue-600">
          <!-- Clipboard icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard">
            <rect width="8" height="4" x="8" y="2" rx="1" ry="1" />
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
          </svg>
        </button>
        <button class="hover:text-blue-600">
          <!-- Search icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.34-4.34" />
          </svg>
        </button>
        <a href="#" class="bg-black text-white px-4 py-2 rounded-lg hover:bg-gray-800 transition-all duration-200">
          Get Started
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="md:hidden flex items-center space-x-4">
        <button class="hover:text-blue-600">
          <!-- Clipboard icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard">
            <rect width="8" height="4" x="8" y="2" rx="1" ry="1" />
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
          </svg>
        </button>
        <button class="hover:text-blue-600">
          <!-- Search icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.34-4.34" />
          </svg>
        </button>
        <button id="mobile-menu-toggle" class="md:hidden text-black focus:outline-none">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
            stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu"
    class="fixed inset-0 z-40 bg-[#232323] text-white px-6 py-8 space-y-6 opacity-0 pointer-events-none transform -translate-y-6 transition-all duration-700 ease-in-out md:hidden">
    <div class="flex flex-row justify-between items-center">
      <h1 class="text-3xl font-extrabold">Zyntics</h1>
      <button id="mobile-menu-close" class="text-white focus:outline-none transition-transform duration-500 ease-in-out">
        <!-- Close icon -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none"
          viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <nav class="space-y-4 text-lg">
      <a href="#" class="block hover:text-blue-600">Home</a>
      <a href="#" class="block hover:text-blue-600">Pages</a>
      <a href="#" class="block hover:text-blue-600">Portfolio</a>
      <a href="#" class="block hover:text-blue-600">Blog</a>
      <a href="#" class="block hover:text-blue-600">Shop</a>
    </nav>
  </div>
</nav>

<!-- Script -->
<script>
  const openBtn = document.getElementById("mobile-menu-toggle");
  const closeBtn = document.getElementById("mobile-menu-close");
  const menu = document.getElementById("mobile-menu");

  const disableScroll = () => {
    document.body.style.overflow = 'hidden';
  };

  const enableScroll = () => {
    document.body.style.overflow = '';
  };

  function openMenu() {
    if (!menu) return;
    menu.classList.remove("pointer-events-none", "opacity-0", "-translate-y-6");
    menu.classList.add("pointer-events-auto", "opacity-100", "translate-y-0");
    disableScroll();
  }

  function closeMenu() {
  if (!menu || !closeBtn) return;

  // Add rotation
  closeBtn.classList.add("rotate-[360deg]");

  // Wait for rotation to finish (~500ms), then hide menu
  setTimeout(() => {
    menu.classList.add("pointer-events-none", "opacity-0", "-translate-y-6");
    menu.classList.remove("pointer-events-auto", "opacity-100", "translate-y-0");
    
    // Reset button rotation so it can re-rotate next time
    closeBtn.classList.remove("rotate-[360deg]");

    enableScroll();
  }, 500);
}


  openBtn?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);

  // Scroll event (skip if menu is open)
  window.addEventListener("scroll", function () {
    const navbar = document.getElementById("main-navbar");
    if (!navbar || menu?.classList.contains("pointer-events-auto")) return;

    if (window.scrollY > 900) {
      navbar.classList.add("md:sticky", "md:top-0", "shadow-md");
    } else {
      navbar.classList.remove("md:sticky", "md:top-0", "shadow-md");
    }
  });
</script>
