<section class="relative w-full px-4 py-16 bg-[#FFFFFF] text-black overflow-hidden">
  <div class="max-w-[1400px] mx-auto ">
      <!-- Glowing Balls -->
 <div class="absolute w-[700px] h-[300px] bg-[#D4EFF7] opacity-300 rounded-full blur-[50px] top- left-[35%] -translate-x-1/2 -translate-y-1/2 z-0"></div>
  <div class="absolute w-[700px] h-[300px] bg-[#D4C5FF] opacity-300 rounded-full blur-[50px] top- left-[65%] -translate-x-1/2 -translate-y-1/2 z-0"></div>
  </div>


  <div class="max-w-7xl mx-auto space-y-6 relative z-10">
    
    <!-- Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-[0.7fr_1fr] gap-6 md:gap-4 items-stretch">
      
      <!-- Left Box: Mission -->
      <div class="bg-[#0a1e4d] rounded-xl p-4 sm:p-6 md:p-8 text-white flex flex-col justify-center">
        <h2 class="font-semibold text-xl sm:text-2xl mb-3">Mission</h2>
        <p class="text-sm sm:text-md leading-tight">
          Certainly, crafting a clear and inspiring mission statement is essential for a development company. It should reflect your company’s values, purpose, and long-term objectives.
        </p>
        <p class="text-sm sm:text-md leading-tight mt-3">
          At XXLando our mission is to empower businesses and organizations through innovative development solutions. We are committed to delivering exceptional, tailored software, websites, and applications that not only meet our clients.
        </p>
      </div>

      <!-- Right Box: Stats & Highlight -->
    <div class="relative min-h-[300px]">
  <!-- Masked Background Layer with Inverted Radius -->
  <div class="absolute inset-0 z-0 longinverted-radius overflow-hidden rounded-xl">
    <!-- Gradient + Image Layer -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#a3c7e3] to-[#a3c7e3]"></div>
    <img
      src="https://storage.googleapis.com/a1aa/image/05473d2f-1579-4e75-f28e-0b5c6ae8c6a3.jpg"
      class="absolute inset-0 w-full h-full object-cover opacity-90"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-[#5B7DBD]/80 to-[#A9C9FF]/80"></div>
  </div>

  <!-- Foreground Content -->
  <div class="relative z-10 px-4 sm:px-6 h-full">
    <!-- Left Text -->
    <div class="absolute bottom-4 sm:bottom-6 left-4 sm:left-6 max-w-[90%] sm:max-w-[60%]">
      <p class="text-white font-bold text-xs sm:text-sm md:text-base leading-snug">
        We create a professional product<br />
        using artificial intelligence
      </p>
    </div>

    <!-- Rotated Count -->
    <div class="absolute top-20 sm:top-28 right-2 sm:right-6 flex flex-col items-center text-white font-extrabold text-2xl sm:text-3xl md:text-4xl leading-none rotate-90 origin-top-right select-none">
      500+
    </div>

    <!-- Project Label -->
    <div class="absolute top-[8rem] sm:top-[11rem] right-2 sm:right-6 text-white text-[10px] sm:text-xs md:text-sm font-normal select-none">
      Created<br />projects
    </div>

    <!-- Action Button (Watch Video) inside curve -->
   <button
  class="absolute bottom-0 right-8 sm:w-30 h-10 sm:h-12  text-black flex items-center justify-center text-xs md:text-lg font-medium rounded-tl-[2.5rem] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-black hover:cursor-pointer"
>
  Watch Video
</button>

  </div>
</div>



