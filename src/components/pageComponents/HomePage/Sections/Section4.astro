---

---
<section class=" max-w-[1400px] mx-auto  sm:py-16 md:py-18">
 <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:g bg-[#F9FCFF] rounded-lg py-4 px-5">
  <!-- Left Content -->
  <div class="flex flex-col relative item-center px-15">
    <!-- Top left logo -->
    <img alt="Colorful hummingbird "
         class="absolute top-0 left-0 rounded-full bg-[#ECECEC]"
         height="40"
         src="https://storage.googleapis.com/a1aa/image/64b7399f-022f-452e-5288-8d625679d66e.jpg"
         width="40" />

    <h1 class="text-[28px] sm:text-3xl md:text-4xl font-extrabold text-[#130f26] leading-tight mt-2 mb-3">
      Driving Growth for<br />Businesses of All-sizes
    </h1>

    <p class="text-[#4b5563] text-md font-semibold sm:text-base leading-relaxed max-w-[420px] mb-8">
      Led by engineers. Backed by strategy. Built for outcomes.
    </p>

    <div class="flex flex-col gap-6 max-w-sm  md:max-w-xl">
  <!-- Buttons -->
  <div class="flex gap-2 bg-white rounded-md shadow-md border border-gray-200 w-fit p-2">
    <button
      id="btn-startups"
      class="tab-btn active flex items-center gap-2 bg-[#0B147C] text-white text-sm font-semibold px-4 py-2 rounded-md hover:cursor-pointer"
      onclick="showTab('startups')"
    >
      <i class="fas fa-envelope"></i> Startups
    </button>
    <button
      id="btn-enterprises"
      class="tab-btn flex items-center gap-2 text-xs text-[#130f26] font-semibold px-4 py-2 rounded-md hover:cursor-pointer"
      onclick="showTab('enterprises')"
    >
      <i class="fas fa-building"></i> Enterprises
    </button>
    <button
      id="btn-agencies"
      class="tab-btn flex items-center gap-2 text-xs text-[#130f26] font-semibold px-4 py-2 rounded-md hover:cursor-pointer"
      onclick="showTab('agencies')"
    >
      <i class="fas fa-briefcase"></i> Agencies
    </button>
  </div>

  <!-- Content Blocks -->
  <div id="tab-content" class="mt-4 max-w-[420px]">
    <!-- Default: Startups -->
    <div id="startups" class="tab-content">
      <h3 class="font-semibold text-lg text-[#130f26] mb-2">Startups</h3>
      <p class="text-[#4b5563] font-semibold text-md leading-relaxed mb-6">
        Helping startups achieve and exceed their business objectives while streamlining operational costs.
      </p>
      <div class="grid grid-cols-2 gap-y-3 text-xs text-[#4b5563]">
        <div class="flex items-center gap-2">
          <i class="fas fa-check-circle text-[#6c63ff] text-sm"></i>
          <span class="font-semibold text-md">MVP Development</span>
        </div>
        <div class="flex items-center gap-2">
          <i class="fas fa-check-circle text-[#6c63ff] text-sm"></i>
          <span class="font-semibold text-md">SaaS Development</span>
        </div>
        <div class="flex items-center gap-2">
          <i class="fas fa-check-circle text-[#6c63ff] text-sm"></i>
          <span class="font-semibold text-md">UI/UX Design</span>
        </div>
        <div class="flex items-center gap-2">
          <i class="fas fa-check-circle text-[#6c63ff] text-sm"></i>
          <span class="font-semibold text-md">Product Development</span>
        </div>
      </div>
      <a href="#" class="inline-flex items-center gap-1 mt-6 text-lg text-[#1e40af] font-semibold underline">
        Get Details <i class="fas fa-arrow-right"></i>
      </a>
    </div>

    <div id="enterprises" class="tab-content hidden">
      <h3 class="font-semibold text-lg text-[#130f26] mb-2">Enterprises</h3>
      <p class="text-[#4b5563] font-semibold text-md leading-relaxed mb-6">
          Modernizing legacy systems, streamlining operations, and integrating AI for impact.      </p>
      <ul class="grid grid-cols-2 gap-y-3 text-xs text-[#4b5563]">
        <li class="flex items-center gap-2">
          <i class="fas fa-check-circle text-[#6c63ff] text-sm"></i>
          <span class="font-semibold text-md">Portals</span>
        </li>
        <li class="flex items-center gap-2">
          <i class="fas fa-check-circle text-[#6c63ff] text-sm"></i>
          <span class="font-semibold text-md"> Custom Integrations</span>
        </li>
        <li class="flex items-center gap-2">
          <i class="fas fa-check-circle text-[#6c63ff] text-sm"></i>
          <span class="font-semibold text-md">Internal Apps</span>
        </li>
        <li class="flex items-center gap-2">
          <i class="fas fa-check-circle text-[#6c63ff] text-sm"></i>
          <span class="font-semibold text-md">AI Dashboards</span>
        </li>
      </ul>
      <a href="#" class="inline-flex items-center gap-1 mt-6 text-lg text-[#1e40af] font-semibold underline">
        Get Details <i class="fas fa-arrow-right"></i>
      </a>
    </div>

    <div id="agencies" class="tab-content hidden">
      <h3 class="font-semibold text-lg text-[#130f26] mb-2">Agencies</h3>
      <p class="text-[#4b5563] font-semibold text-md leading-relaxed mb-6">
        White-label partners for code execution, product launches, and staff augmentation.
      </p>
      <ul class="grid grid-cols-2 gap-y-3 text-xs text-[#4b5563]">
        <li class="flex items-center gap-2">
          <i class="fas fa-check-circle text-[#6c63ff] text-sm"></i>
          <span class="font-semibold text-md">Remote Teams</span>
        </li>
        <li class="flex items-center gap-2">
          <i class="fas fa-check-circle text-[#6c63ff] text-sm"></i>
          <span class="font-semibold text-md">Branded Dev Support</span>
        </li>
        <li class="flex items-center gap-2">
          <i class="fas fa-check-circle text-[#6c63ff] text-sm"></i>
          <span class="font-semibold text-md">UI/UX Builds</span>
        </li>
        <li class="flex items-center gap-2">
          <i class="fas fa-check-circle text-[#6c63ff] text-sm"></i>
          <span class="font-semibold text-md">Scale on Demand</span>
        </li>
      </ul>
      <a href="#" class="inline-flex items-center gap-1 mt-6 text-lg text-[#1e40af] font-semibold underline">
        Get Details <i class="fas fa-arrow-right"></i>
      </a>
    </div>
  </div>
</div>

    <!-- Bottom left logo -->
    <img alt="Colorful hummingbird logo icon on light background"
         class="absolute -bottom-8 left-0 opacity-30 rounded-full"
         height="40"
         src="https://storage.googleapis.com/a1aa/image/64b7399f-022f-452e-5288-8d625679d66e.jpg"
         width="40" />
  </div>

  <!-- Right Content (ONLY IMAGE) -->
  <div class="flex justify-center items-center px-15">
    <img alt="Group of business people in a meeting room discussing around a laptop"
         class="rounded-xl shadow-lg md:max-w-100 sm:max-w-50 h-auto"
         src="https://storage.googleapis.com/a1aa/image/08f483e6-e85e-4a12-c30a-152f7f51bae5.jpg" />
  </div>
</div>

</section>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    function showTab(tab: string): void {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('bg-[#0B147C]', 'text-white');
        btn.classList.add('text-[#130f26]');
      });

      document.getElementById(tab)?.classList.remove('hidden');

      const activeBtn = document.getElementById(`btn-${tab}`);
      if (activeBtn !== null) {
        activeBtn.classList.remove('text-[#130f26]');
        activeBtn.classList.add('bg-[#0B147C]', 'text-white');
      }
    }

  (window as typeof window & { showTab: (tab: string) => void }).showTab = showTab;
  });
</script>
